<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tree_life"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary">

            <TextView
                style="@style/Toolbar.TitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_tree_title" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/parent_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/coin_balance"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/parent_margin"
                    android:src="@drawable/ic_shimjeong_coin" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_profile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_profile_gradient" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="PP"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>


    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/level_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_level_1"
                style="@style/LevelChip"
                android:checked="true"
                android:text="Individual" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_level_2"
                style="@style/LevelChip"
                android:enabled="false"
                android:text="Family" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_level_3"
                style="@style/LevelChip"
                android:enabled="false"
                android:text="Generational" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>


    <TextView
        android:id="@+id/tree_stage_label"
        style="@style/StatusTreeLifeText"
        android:layout_margin="@dimen/parent_margin"
        tools:text="Status: beginner" />

    <LinearLayout
        android:id="@+id/tree_warn_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_warn_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_warning" />

        <TextView
            android:id="@+id/tree_warn_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/simple_text"
            android:textSize="12sp"
            tools:text="За місяць зроблено 14 хдх. Потрібно мінімум 20" />

    </LinearLayout>

    <ImageView
        android:id="@+id/tree_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center_vertical"
        android:layout_marginBottom="40dp"
        android:layout_weight="1"
        tools:src="@drawable/tree_stage_1" />

    <com.vadym.gvd.bestfriendskotlin.treelife.StageDotsView
        android:id="@+id/tree_stage_dots"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="@dimen/parent_margin"
        android:layout_marginBottom="40dp" />
</LinearLayout>