<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_status_fulfill"
    android:gravity="center_vertical"
    android:padding="@dimen/parent_margin">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_tree_life" />

    <TextView
        android:id="@+id/fulfill_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        tools:text="Вірний" />

    <TextView
        android:id="@+id/fulfil_req"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/profile_status_level"
        android:textSize="11sp"
        tools:text="Пройдено" />

</LinearLayout>