<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:padding="0dp"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp">

        <TextView
            style="@style/Toolbar.TitleText"
            android:text="@string/phrase_day" />

    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <ImageView
            android:id="@+id/scrollClosed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="rolled_scroll"
            android:src="@drawable/rolled_scroll"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.498" />

        <ImageView
            android:id="@+id/scrollOpened"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="opened_scroll"
            android:src="@drawable/opened_scroll2"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_on_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="15dp"
            android:text="@string/pre_text_phrase"
            android:textColor="#FFAFAF"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@+id/scrollClosed"
            app:layout_constraintEnd_toEndOf="@id/scrollClosed"
            app:layout_constraintStart_toStartOf="@id/scrollClosed"
            app:layout_constraintTop_toTopOf="@id/scrollClosed"
            app:layout_constraintVertical_bias="0.47" />

        <TextView
            android:id="@+id/text_phrase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/stableBlack"
            android:gravity="center"
            android:textSize="@dimen/text_size_phrase"
            app:layout_constraintBottom_toBottomOf="@id/scrollOpened"
            app:layout_constraintEnd_toEndOf="@id/scrollOpened"
            app:layout_constraintStart_toStartOf="@id/scrollOpened"
            app:layout_constraintTop_toTopOf="@id/scrollOpened"
            app:layout_constraintWidth_percent="0.6" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>