<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp">

        <TextView
            style="@style/Toolbar.TitleText"
            android:text="@string/anthem_chonilguk" />

        <ImageView
            android:id="@+id/coin_anthem_16"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="@dimen/parent_margin"
            android:src="@drawable/ic_shimjeong_coin"
            android:visibility="gone"
            tools:visibility="visible" />

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/parent_margin">

        <ImageView
            android:id="@+id/iv_play"
            style="@style/ButtonAnthem"
            android:src="@drawable/ic_play"
            app:tint="@color/color_primary_disable" />

        <ImageView
            android:id="@+id/coin_anthem_15"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="2"
            android:src="@drawable/ic_shimjeong_coin"
            android:visibility="gone"
            tools:visibility="visible" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/iv_pause"
            style="@style/ButtonAnthem"
            android:src="@drawable/ic_pause"
            app:tint="@color/color_pause_disable" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/coin_anthem_14"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="2"
            android:src="@drawable/ic_shimjeong_coin"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/iv_stop"
            style="@style/ButtonAnthem"
            android:src="@drawable/ic_stop"
            app:tint="@color/color_accent_disable" />
    </LinearLayout>

    <View style="@style/AppTheme.HorizontalViewDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            style="@style/Kajon_mense"
            android:paddingStart="@dimen/parent_margin"
            android:paddingEnd="@dimen/parent_margin"
            android:paddingBottom="@dimen/margin24"
            android:text="@string/anthem_text" />

    </ScrollView>
</LinearLayout>