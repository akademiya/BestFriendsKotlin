<?xml version="1.0" encoding="utf-8"?>
<com.vadym.gvd.bestfriendskotlin.calendar.SquareLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="3dp">

    <TextView
        android:id="@+id/txt1"
        style="@style/DayHeader"
        android:layout_width="match_parent"
        tools:text="12" />

    <TextView
        android:id="@+id/txt2"
        style="@style/DayHeader"
        android:layout_width="match_parent"
        android:textSize="10sp"
        tools:text="(1-13)" />

</com.vadym.gvd.bestfriendskotlin.calendar.SquareLinearLayout>